{
  "nQueued": { "type": "U8", "description": "# of data blocks queued for this dive"},
  "nTries": { "type": "U16", "description": "# of tries to get the data block receive status in previous dive (Not Valid)"},
  "Vcpu": { "type": "U16", "scale": 0.01, "prec":2, "units":"V", "description": "CPU battery voltage"},
  "Vpmp": { "type": "U16", "scale": 0.01, "prec":2, "units":"V", "description": "present Pump battery voltage"},
  "Vple": { "type": "U16", "scale": 0.01, "prec":2, "units":"V", "description": "pump battery voltage at end of last pump"},
  "vacBIT0": { "type": "U16", "scale": 0.01, "prec":2, "units":"inHg","description": "pcase vacuum @BITest"},
  "vac0": { "type": "U16", "scale": 0.01, "prec":2, "units":"inHg", "description": "pcase vacuum before filling oil bladder at surface"},
  "vac1": { "type": "U16", "scale": 0.01, "prec":2, "units":"inHg", "description": "pcase vacuum after filling oil bladder at surface"},
  "ISRID": { "type": "U16", "description": "ID of last interrupt"},
  "HPavgI": { "type": "U16", "units": "mA", "description": "average pump current at bottom"},
  "HPmaxI": { "type": "U16", "units": "mA", "description": "max pump current at bottom"},
  "PumpT_Hi": { "type": "U16", "units": "s", "description": "total time pumped out, up to the last surface pump"},
  "PumpT_Lo": { "type": "U16", "units": "s", "description": "Surface pump time"},
  "P[5]": { "type": "U16", "scale":"pres", "offset":"pres", "units": "dbar", "description": "Pressure at end of ascent"},
  "SPRX": { "type": "U16", "scale":"pres", "offset":"pres", "units": "dbar", "description": "Surface pressure before reset offset (previous dive)"},
  "SPRXL": { "type": "U16", "scale":"pres", "offset":"pres", "units": "dbar", "description": "Surface pressure after reset offset (previous dive)"},
  "diagP0": { "type": "U16", "scale":"pres", "offset":"pres", "units": "dbar", "description": "Pressure scan at start of ascent"},
  "diagT0": { "type": "U16", "scale":"temp", "offset":"temp", "units": "degC", "description": "Temperature scan at start of ascent"},
  "diagS0": { "type": "U16", "scale":"psal", "offset":"psal", "units": "psu", "description": "Salinity scan at start of ascent"},
  "SBnScan": { "type": "I16", "description": "# scans recorded by SBE"},
  "SBEntry": { "type": "U16", "mask": "0xfff0", "description": "SBE attempts"},
  "SBEstrt": { "type": "U16", "mask": "0x000c", "description": "SBE start"},
  "SBEstop": { "type": "U16", "mask": "0x0003", "description": "SBE stop"},
  "diagP1": { "type": "U16", "scale":"pres", "offset":"pres", "units": "dbar", "description": "Pressure after ascent"},
  "diagT1": { "type": "U16", "scale":"temp", "offset":"temp", "units": "degC", "description": "Temperature after ascent"},
  "diagS1": { "type": "U16", "scale":"psal", "offset":"psal", "units": "psu", "description": "Salinity after ascent"},
  "vacBIT": { "type": "U16", "scale":0.01, "prec":2, "units":"inHg", "description": "BITest vacuum"},
  "ampBIT": { "type": "U16", "units":"mA", "description": "BIT motor current"},
  "secBIT": { "type": "U16", "units":"s","description": "BIT motor run-time"},
  "oilBITp": { "type": "U8", "units":"","description": "BIT oil counts prior to pump"},
  "oilBITa": { "type": "U8", "units":"","description": "BIT oil counts after pump"},
  "VpmpBIT": { "type": "U16", "scale":0.01, "prec":2, "units": "V", "description": "BIT pump voltage"},
  "VcpuBIT": { "type": "U16", "scale":0.01, "prec":2, "units": "V", "description": "BIT cpu voltage"},
  "exc_stat": { "type": "U16", "description":"exception status"},
  "ventTm": { "type": "U8", "scale":0.1, "prec":1, "units": "s", "description":"time that air vent motor ran at 50dbar"},
  "ventStat": { "type": "U8", "mask": "0x0f", "description":"LLD status (air present) before and after the air vent ran (50dbar): 0x0001 Prior, 0x0010 Immed. After, 0x0100 10s After"},
  "OPVTStat": { "type": "U8", "mask": "0xf0", "description":"LLD status (air present) before and after the air vent ran (Other pumps): 0x0001 Prior, 0x0010 Immed. After, 0x0100 10s After"},
  "abortFlg": { "type": "U16", "description": "Abort status flag: 0=OK,2=BAD_P,3=BAD_TX,4=SHORE_CMD,5=FINAL_DIVE,6=BAD_PHASE,7=CANT_SURFACE,8=BEACON_TX,9=TIMED_OUT,32=WD_TIMER"},
  "RH": { "type": "U16", "units": "%", "description": "Relative Humidity at start of ascent"}
}
